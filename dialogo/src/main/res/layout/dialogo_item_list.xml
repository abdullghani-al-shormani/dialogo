<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:minHeight="56dp">

    <!-- أيقونة العنصر (اختيارية) -->
    <ImageView
        android:id="@+id/dialogo_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:visibility="gone"
        tools:src="@android:drawable/ic_menu_edit"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/dialogo_tv_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#1F2937"
        android:textSize="16sp"
        tools:text="عنصر القائمة 1" />

    <RadioButton
        android:id="@+id/dialogo_radio_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="gone" />

    <CheckBox
        android:id="@+id/dialogo_checkbox_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="gone" />

</LinearLayout>