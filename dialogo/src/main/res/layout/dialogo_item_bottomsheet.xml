<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Leading Icon -->
    <ImageView
        android:id="@+id/dialogo_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:visibility="gone"
        tools:src="@android:drawable/ic_menu_edit"
        tools:visibility="visible" />

    <!-- Text -->
    <TextView
        android:id="@+id/dialogo_tv_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#1F2937"
        android:textSize="16sp"
        tools:text="عنصر القائمة" />

    <!-- Radio (Single Choice) -->
    <RadioButton
        android:id="@+id/dialogo_radio_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- Checkbox (Multi Choice) -->
    <CheckBox
        android:id="@+id/dialogo_checkbox_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- Trailing Chevron (للعناصر العادية) -->
    <ImageView
        android:id="@+id/dialogo_item_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@android:drawable/arrow_down_float"
        android:rotation="-90"
        android:visibility="gone"
        android:tint="#9CA3AF"
        tools:visibility="gone" />

</LinearLayout>