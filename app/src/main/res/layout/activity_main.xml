<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Dialogo Library - Complete Samples"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ==================== Basic ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="- Basic Dialogs -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btSimpleDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="1. Simple Alert" />

        <Button
            android:id="@+id/btConfirmDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="2. Confirm" />

        <Button
            android:id="@+id/btStyledDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="3. Fully Styled" />

        <Button
            android:id="@+id/btIconDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="4. With Icon" />

        <Button
            android:id="@+id/btHtmlMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="5. HTML Message" />

        <!-- ==================== Presets ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="- Preset Dialogs -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="6. Success" />

        <Button
            android:id="@+id/btError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="7. Error" />

        <Button
            android:id="@+id/btWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="8. Warning" />

        <Button
            android:id="@+id/btInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="9. Info" />

        <Button
            android:id="@+id/btLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="10. Loading" />

        <Button
            android:id="@+id/btDeleteConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="11. Delete Confirm" />

        <!-- ==================== Input and Lists ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="- Input and Lists -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btInputDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="12. Input (Required)" />

        <Button
            android:id="@+id/btSingleChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="13. Single Choice" />

        <Button
            android:id="@+id/btMultiChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="14. Multi Choice" />

        <!-- ==================== Progress ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="- Progress -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btProgressDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="15. Horizontal Progress" />

        <Button
            android:id="@+id/btIndeterminateProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="16. Indeterminate Progress" />

        <!-- ==================== Custom ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="- Custom and Advanced -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btCustomView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="17. Custom View" />

        <Button
            android:id="@+id/btAutoDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="18. Auto Dismiss 3s" />

        <Button
            android:id="@+id/btNonCancelable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="19. Non-Cancelable" />

        <Button
            android:id="@+id/btFullExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="20. Full Featured" />

        <!-- ==================== Animations ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="- Animations -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btAnimScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="21. Animation Scale" />

        <Button
            android:id="@+id/btAnimFade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="22. Animation Fade" />

        <Button
            android:id="@+id/btAnimSlideUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="23. Animation Slide Up" />

        <Button
            android:id="@+id/btAnimBounce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="24. Animation Bounce" />

        <Button
            android:id="@+id/btAnimShake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="25. Animation Shake" />

        <!-- ==================== Themes ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="- Themes -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btThemeMaterial3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="26. Theme Material 3" />

        <Button
            android:id="@+id/btThemeIOS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="27. Theme iOS" />

        <Button
            android:id="@+id/btThemeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="28. Theme Dark" />

        <Button
            android:id="@+id/btThemeMinimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="29. Theme Minimal" />

        <Button
            android:id="@+id/btThemeRounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="30. Theme Rounded" />

        <Button
            android:id="@+id/btBottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="31. BottomSheet Dialog" />

        <!-- ==================== Popup & Positions ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="- Popups and Positions -"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btPositionTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="32. Modal: Top" />

        <Button
            android:id="@+id/btPositionCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="33. Modal: Center" />

        <Button
            android:id="@+id/btPositionBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="34. Modal: Bottom" />

        <Button
            android:id="@+id/btPopupTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="35. Popup (Non-Modal): Top" />

        <Button
            android:id="@+id/btPopupCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="36. Popup (Non-Modal): Center" />

        <Button
            android:id="@+id/btPopupBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="37. Popup (Non-Modal): Bottom" />

        <Button
            android:id="@+id/btPopupAutoDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="38. Popup Auto-Dismiss (3s)" />

        <Button
            android:id="@+id/btPopupSlideDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="39. Popup Slide Down Animation" />

    </LinearLayout>
</ScrollView>